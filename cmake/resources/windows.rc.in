#include <winver.h>

IDI_ICON1   ICON    "@RES_DIR@/icon.ico"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION        @NOCTIS_VERSION_MAJOR@,@NOCTIS_VERSION_MINOR@,@NOCTIS_VERSION_PATCH@,0
    PRODUCTVERSION     @NOCTIS_VERSION_MAJOR@,@NOCTIS_VERSION_MINOR@,@NOCTIS_VERSION_PATCH@,0
    FILEFLAGSMASK      VS_FFI_FILEFLAGSMASK
    FILEFLAGS          VS_FF_SPECIALBUILD
    FILEOS             VOS__WINDOWS32
    FILETYPE           VFT_APP
    FILESUBTYPE        0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "ProductName",      "Chatterino Noctis"
            VALUE "ProductVersion",   "@NOCTIS_VERSION@"
            VALUE "CompanyName",      "Mist1X"
            VALUE "FileDescription",  "@NOCTIS_FILE_DESCRIPTION@"
            VALUE "FileVersion",      "@NOCTIS_VERSION@"
            VALUE "SpecialBuild",     "@GIT_COMMIT@"
            VALUE "InternalName",     "@NOCTIS_INTERNAL_NAME@"
            VALUE "OriginalFilename", "@NOCTIS_INTERNAL_NAME@.exe"
            VALUE "LegalCopyright",   "Project contributors 2016-@CURRENT_YEAR@"
            VALUE "Licence",          "MIT"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
