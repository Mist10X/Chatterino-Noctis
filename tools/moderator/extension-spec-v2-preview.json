{
  "type": "noctis-moderator-extension",
  "schema": 1,
  "host_api": 2,
  "revision": 4,
  "version": "2.1.0",
  "labels": {
    "rewards": {"en": "Reward scenarios", "ru": "Сценарии наград"},
    "words": {"en": "Chat rules", "ru": "Правила чата"}
  },
  "layout": {
    "reply_tabs": ["rules", "options", "timer"],
    "moderation_tabs": ["rewards", "words", "history"]
  },
  "pages": [
    {
      "title": {"en": "What's new", "ru": "Что нового"},
      "body": {
        "en": "This module update adds a configurable warning for words, changes tab order and labels. It needs no client restart. Existing adaptive reward rules stay intact.",
        "ru": "Обновление модуля добавляет настраиваемое предупреждение за слова, меняет порядок и названия вкладок. Перезапуск клиента не нужен. Существующие настраиваемые награды сохраняются."
      }
    }
  ],
  "reward_actions": [
    {
      "id": "random-timeout-1-3-min",
      "title": {"en": "Timeout: random 1–3 min", "ru": "Мут: случайно 1–3 мин"},
      "minimum_seconds": 60,
      "maximum_seconds": 180
    },
    {
      "id": "adaptive-reward",
      "title": {"en": "Adaptive reward", "ru": "Настраиваемая награда"},
      "sources": ["reward"],
      "fields": [
        {
          "id": "mode", "type": "choice",
          "title": {"en": "Action", "ru": "Действие"},
          "default": "timeout",
          "choices": [
            {"id": "timeout", "title": {"en": "Timeout", "ru": "Мут"}},
            {"id": "untimeout", "title": {"en": "Remove timeout", "ru": "Размут"}},
            {"id": "reply", "title": {"en": "Reply", "ru": "Ответ"}},
            {"id": "skip", "title": {"en": "Skip", "ru": "Без действия"}}
          ]
        },
        {"id": "min-seconds", "type": "integer", "title": {"en": "Minimum (s)", "ru": "Минимум, с"}, "default": 60, "minimum": 1, "maximum": 86400},
        {"id": "max-seconds", "type": "integer", "title": {"en": "Maximum (s)", "ru": "Максимум, с"}, "default": 180, "minimum": 1, "maximum": 86400},
        {"id": "message", "type": "text", "title": {"en": "Reply text", "ru": "Текст ответа"}, "default": "Награда обработана:", "maximum": 400}
      ],
      "program": {
        "operation": {"param": "mode"},
        "seconds": {"random": [{"param": "min-seconds"}, {"param": "max-seconds"}]},
        "text": {"concat": [{"param": "message"}, " ", {"event": "target"}]}
      }
    },
    {
      "id": "word-warning",
      "title": {"en": "Configurable warning", "ru": "Настраиваемое предупреждение"},
      "sources": ["message"],
      "fields": [
        {"id": "warning", "type": "text", "title": {"en": "Warning", "ru": "Текст предупреждения"}, "default": "Пожалуйста, соблюдайте правила чата.", "maximum": 400},
        {"id": "mention", "type": "boolean", "title": {"en": "Mention the author", "ru": "Упомянуть автора"}, "default": false}
      ],
      "program": {
        "operation": "reply",
        "text": {"if": [{"param": "mention"}, {"concat": ["@", {"event": "buyer"}, " ", {"param": "warning"}]}, {"param": "warning"}]}
      }
    }
  ]
}
